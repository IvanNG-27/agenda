rules_version = '2';

// Cada usuario solo puede leer y escribir sus propios datos (users/{su uid} y lo que hay debajo),
// y solo con la forma exacta que usa la app: campos permitidos, tipos, formatos y tamaños.
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Texto obligatorio de 1 a `max` caracteres
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Campo opcional: si está, es texto de hasta `max` caracteres
    function optText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Lista de días estudiados: el contenido lo valida la app; aquí se limita el tamaño
    function dayList(v) {
      return v is list && v.size() <= 3660;
    }

    // Recordatorios de un elemento: hasta 3 (minutos respecto a su inicio, ver src/lib/reminders.ts)
    function reminderList(d) {
      return !('reminders' in d) || (d.reminders is list && d.reminders.size() <= 3);
    }

    // Recordatorio pendiente en la nube: lo envía por push scripts/reminders/send.mjs cuando vence
    function validReminder(d, id) {
      return d.keys().hasOnly(['uid', 'item', 'at', 'title', 'body', 'yearly'])
        && d.keys().hasAll(['uid', 'item', 'at', 'title'])
        && d.uid == request.auth.uid
        && id == request.auth.uid + '_' + d.item
        && d.item is string && d.item.matches('^[A-Za-z0-9_-]{1,140}$')
        && d.at is int
        && text(d.title, 150)
        && optText(d, 'body', 280)
        && (!('yearly' in d) || d.yearly is bool);
    }

    // Navegador registrado para recibir push (el token de Firebase Cloud Messaging)
    function validDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && text(d.token, 4096)
        && optText(d, 'platform', 20)
        && d.updatedAt is int;
    }

    // Nota libre (apartado Notas): título, texto, lista de hasta 50 puntos, color y fijada
    function validNote(d, id) {
      return d.keys().hasOnly(['id', 'title', 'text', 'items', 'color', 'pinned', 'updatedAt'])
        && d.keys().hasAll(['id', 'updatedAt'])
        && d.id == id
        && optText(d, 'title', 120)
        && optText(d, 'text', 5000)
        && (!('items' in d) || (d.items is list && d.items.size() <= 50))
        && (!('color' in d) || (d.color is string && (d.color.matches('^subj-[a-z]{1,20}$') || d.color.matches('^#[0-9a-f]{6}$'))))
        && (!('pinned' in d) || d.pinned is bool)
        && d.updatedAt is int;
    }

    // ---------- Grupos ----------

    function memberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }

    function isMember(gid) {
      return request.auth != null && exists(memberPath(gid));
    }

    // Quien administra o tiene permiso de edición
    function canWrite(gid) {
      return isMember(gid) && get(memberPath(gid)).data.role in ['owner', 'editor'];
    }

    function isGroupOwner(gid) {
      return request.auth != null && get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid;
    }

    function validColor(c) {
      return c is string && (c.matches('^subj-[a-z]{1,20}$') || c.matches('^#[0-9a-f]{6}$'));
    }

    function validGroup(d) {
      return d.keys().hasOnly(['name', 'color', 'ownerId', 'createdAt'])
        && d.keys().hasAll(['name', 'color', 'ownerId', 'createdAt'])
        && text(d.name, 60)
        && validColor(d.color)
        && d.ownerId is string
        && d.createdAt is int;
    }

    function validMember(d) {
      return d.keys().hasOnly(['role', 'name', 'joinedAt', 'code'])
        && d.keys().hasAll(['role', 'name', 'joinedAt'])
        && d.role in ['owner', 'editor', 'viewer']
        && text(d.name, 60)
        && d.joinedAt is int
        && (!('code' in d) || d.code is string);
    }

    // Código de invitación: existe, es de este grupo y no ha caducado
    function validInvite(code, gid) {
      let inv = get(/databases/$(database)/documents/invites/$(code));
      return code.matches('^[A-HJKMNP-Z2-9]{10}$') && inv.data.groupId == gid && inv.data.expires > request.time.toMillis();
    }

    // Lista de grupos de una persona (users/{uid}/groups/{gid}); invite solo la guarda quien administra
    function validGroupLink(d) {
      return d.keys().hasOnly(['joinedAt', 'invite'])
        && (!('joinedAt' in d) || d.joinedAt is int)
        && (!('invite' in d) || (d.invite is map
          && d.invite.keys().hasOnly(['code', 'expires'])
          && d.invite.code is string && d.invite.code.size() <= 12
          && d.invite.expires is int));
    }

    function validProfile(d) {
      return d.keys().hasOnly(['userName', 'studyLog'])
        && (!('userName' in d) || (d.userName is string && d.userName.size() <= 40))
        && (!('studyLog' in d) || dayList(d.studyLog));
    }

    function validSubject(d, id) {
      return d.keys().hasOnly(['id', 'name', 'short', 'color', 'order'])
        && d.keys().hasAll(['id', 'name', 'short', 'color'])
        && d.id == id
        // Pueden quedar vacíos un momento mientras se editan en Ajustes
        && d.name is string && d.name.size() <= 60
        && d.short is string && d.short.size() <= 12
        // Uno de la paleta (subj-…) o uno personalizado (#rrggbb)
        && d.color is string && (d.color.matches('^subj-[a-z]{1,20}$') || d.color.matches('^#[0-9a-f]{6}$'))
        && (!('order' in d) || (d.order is int && d.order >= 0 && d.order <= 999));
    }

    function validTask(d, id) {
      return d.keys().hasOnly(['id', 'title', 'subjectId', 'dueDate', 'done', 'doneAt', 'notes', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'subjectId', 'dueDate', 'done'])
        && d.id == id
        && text(d.title, 120)
        && text(d.subjectId, 60)
        && isoDate(d.dueDate)
        && d.done is bool
        && (!('doneAt' in d) || isoDate(d.doneAt))
        && optText(d, 'notes', 2000)
        && reminderList(d);
    }

    function validExam(d, id) {
      return d.keys().hasOnly(['id', 'title', 'subjectId', 'date', 'time', 'prep', 'studyDays', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'subjectId', 'date', 'prep'])
        && d.id == id
        && text(d.title, 120)
        && text(d.subjectId, 60)
        && isoDate(d.date)
        && optText(d, 'time', 30)
        && d.prep is number && d.prep >= 0 && d.prep <= 100
        && (!('studyDays' in d) || dayList(d.studyDays))
        && reminderList(d);
    }

    function validEvent(d, id) {
      return d.keys().hasOnly(['id', 'title', 'kind', 'date', 'time', 'place', 'notes', 'yearly', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'kind', 'date'])
        && d.id == id
        && text(d.title, 120)
        && d.kind in ['cumple', 'comida', 'quedada', 'medico', 'importante', 'otro']
        && isoDate(d.date)
        && (!('time' in d) || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && optText(d, 'place', 120)
        && optText(d, 'notes', 2000)
        && (!('yearly' in d) || d.yearly is bool)
        && reminderList(d);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /subjects/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSubject(request.resource.data, id);
      }
      match /tasks/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask(request.resource.data, id);
      }
      match /exams/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validExam(request.resource.data, id);
      }
      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent(request.resource.data, id);
      }
      match /notes/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote(request.resource.data, id);
      }
      match /devices/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDevice(request.resource.data);
      }
      match /groups/{gid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGroupLink(request.resource.data);
      }
      // Cualquier otra colección bajo users/{uid} queda cerrada
    }

    // Calendarios compartidos. Leer: sus miembros. Añadir y cambiar lo de dentro: quien administra y los editores.
    match /groups/{gid} {
      allow read: if isMember(gid) || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && validGroup(request.resource.data);
      allow update: if isGroupOwner(gid)
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGroupOwner(gid);

      match /members/{uid} {
        allow read: if isMember(gid);
        // Quien crea el grupo se apunta como administrador; los demás, solo como lectores y con un código válido
        allow create: if request.auth != null && request.auth.uid == uid && validMember(request.resource.data) && (
          (request.resource.data.role == 'owner' && isGroupOwner(gid))
          || (request.resource.data.role == 'viewer' && 'code' in request.resource.data
              && validInvite(request.resource.data.code, gid))
        );
        // Solo quien administra cambia papeles (editor o lector), y nunca el suyo
        allow update: if isGroupOwner(gid) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer'];
        // Quien administra puede sacar a cualquiera; cada uno puede salir (salvo quien administra: borra el grupo)
        allow delete: if isGroupOwner(gid) || (request.auth != null && request.auth.uid == uid && resource.data.role != 'owner');
      }

      match /subjects/{id} {
        allow read: if isMember(gid);
        allow delete: if canWrite(gid);
        allow create, update: if canWrite(gid) && validSubject(request.resource.data, id);
      }
      match /tasks/{id} {
        allow read: if isMember(gid);
        allow delete: if canWrite(gid);
        allow create, update: if canWrite(gid) && validTask(request.resource.data, id);
      }
      match /exams/{id} {
        allow read: if isMember(gid);
        allow delete: if canWrite(gid);
        allow create, update: if canWrite(gid) && validExam(request.resource.data, id);
      }
      match /events/{id} {
        allow read: if isMember(gid);
        allow delete: if canWrite(gid);
        allow create, update: if canWrite(gid) && validEvent(request.resource.data, id);
      }
      match /notes/{id} {
        allow read: if isMember(gid);
        allow delete: if canWrite(gid);
        allow create, update: if canWrite(gid) && validNote(request.resource.data, id);
      }
    }

    // Códigos de invitación: se pueden consultar por el código exacto (quien lo sabe), nunca listar.
    // Solo quien administra el grupo los crea (como mucho 8 días) y los borra.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[A-HJKMNP-Z2-9]{10}$')
        && request.resource.data.keys().hasOnly(['groupId', 'expires', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && isGroupOwner(request.resource.data.groupId)
        && request.resource.data.expires is int
        && request.resource.data.expires <= request.time.toMillis() + 8 * 86400000;
      allow delete: if request.auth != null && isGroupOwner(resource.data.groupId);
    }

    // Recordatorios: colección única para que el envío programado los busque por fecha sin índices especiales.
    // Cada documento solo lo ve y lo toca su dueño (campo uid), y su id empieza por ese uid.
    match /reminders/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && validReminder(request.resource.data, id);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validReminder(request.resource.data, id);
    }
  }
}
