rules_version = '2';

// Cada usuario solo puede leer y escribir sus propios datos (users/{su uid} y lo que hay debajo),
// y solo con la forma exacta que usa la app: campos permitidos, tipos, formatos y tamaños.
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Texto obligatorio de 1 a `max` caracteres
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Campo opcional: si está, es texto de hasta `max` caracteres
    function optText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Lista de días estudiados: el contenido lo valida la app; aquí se limita el tamaño
    function dayList(v) {
      return v is list && v.size() <= 3660;
    }

    // Recordatorios de un elemento: hasta 3 (minutos respecto a su inicio, ver src/lib/reminders.ts)
    function reminderList(d) {
      return !('reminders' in d) || (d.reminders is list && d.reminders.size() <= 3);
    }

    // Recordatorio pendiente en la nube: lo envía por push scripts/reminders/send.mjs cuando vence
    function validReminder(d, id) {
      return d.keys().hasOnly(['uid', 'item', 'at', 'title', 'body', 'yearly'])
        && d.keys().hasAll(['uid', 'item', 'at', 'title'])
        && d.uid == request.auth.uid
        && id == request.auth.uid + '_' + d.item
        && d.item is string && d.item.matches('^[A-Za-z0-9_-]{1,140}$')
        && d.at is int
        && text(d.title, 150)
        && optText(d, 'body', 280)
        && (!('yearly' in d) || d.yearly is bool);
    }

    // Navegador registrado para recibir push (el token de Firebase Cloud Messaging)
    function validDevice(d) {
      return d.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && text(d.token, 4096)
        && optText(d, 'platform', 20)
        && d.updatedAt is int;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['userName', 'studyLog'])
        && (!('userName' in d) || (d.userName is string && d.userName.size() <= 40))
        && (!('studyLog' in d) || dayList(d.studyLog));
    }

    function validSubject(d, id) {
      return d.keys().hasOnly(['id', 'name', 'short', 'color', 'order'])
        && d.keys().hasAll(['id', 'name', 'short', 'color'])
        && d.id == id
        // Pueden quedar vacíos un momento mientras se editan en Ajustes
        && d.name is string && d.name.size() <= 60
        && d.short is string && d.short.size() <= 12
        && d.color is string && d.color.matches('^subj-[a-z]{1,20}$')
        && (!('order' in d) || (d.order is int && d.order >= 0 && d.order <= 999));
    }

    function validTask(d, id) {
      return d.keys().hasOnly(['id', 'title', 'subjectId', 'dueDate', 'done', 'doneAt', 'notes', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'subjectId', 'dueDate', 'done'])
        && d.id == id
        && text(d.title, 120)
        && text(d.subjectId, 60)
        && isoDate(d.dueDate)
        && d.done is bool
        && (!('doneAt' in d) || isoDate(d.doneAt))
        && optText(d, 'notes', 2000)
        && reminderList(d);
    }

    function validExam(d, id) {
      return d.keys().hasOnly(['id', 'title', 'subjectId', 'date', 'time', 'prep', 'studyDays', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'subjectId', 'date', 'prep'])
        && d.id == id
        && text(d.title, 120)
        && text(d.subjectId, 60)
        && isoDate(d.date)
        && optText(d, 'time', 30)
        && d.prep is number && d.prep >= 0 && d.prep <= 100
        && (!('studyDays' in d) || dayList(d.studyDays))
        && reminderList(d);
    }

    function validEvent(d, id) {
      return d.keys().hasOnly(['id', 'title', 'kind', 'date', 'time', 'place', 'notes', 'yearly', 'reminders'])
        && d.keys().hasAll(['id', 'title', 'kind', 'date'])
        && d.id == id
        && text(d.title, 120)
        && d.kind in ['cumple', 'comida', 'quedada', 'medico', 'importante', 'otro']
        && isoDate(d.date)
        && (!('time' in d) || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && optText(d, 'place', 120)
        && optText(d, 'notes', 2000)
        && (!('yearly' in d) || d.yearly is bool)
        && reminderList(d);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /subjects/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSubject(request.resource.data, id);
      }
      match /tasks/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask(request.resource.data, id);
      }
      match /exams/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validExam(request.resource.data, id);
      }
      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent(request.resource.data, id);
      }
      match /devices/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDevice(request.resource.data);
      }
      // Cualquier otra colección bajo users/{uid} queda cerrada
    }

    // Recordatorios: colección única para que el envío programado los busque por fecha sin índices especiales.
    // Cada documento solo lo ve y lo toca su dueño (campo uid), y su id empieza por ese uid.
    match /reminders/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && validReminder(request.resource.data, id);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validReminder(request.resource.data, id);
    }
  }
}
